{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug - full build (Studio + runtime + tests + CLI)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BULLY_BUILD_STUDIO": "ON",
        "BULLY_BUILD_RUNTIME": "ON",
        "BULLY_BUILD_TESTS": "ON",
        "BULLY_BUILD_CLI": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless - no Qt, no SDL (CI, containers, agents)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BULLY_BUILD_STUDIO": "OFF",
        "BULLY_BUILD_RUNTIME": "OFF",
        "BULLY_BUILD_TESTS": "ON",
        "BULLY_BUILD_CLI": "ON",
        "BULLY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release - optimised full build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BULLY_BUILD_STUDIO": "ON",
        "BULLY_BUILD_RUNTIME": "ON",
        "BULLY_BUILD_TESTS": "ON",
        "BULLY_BUILD_CLI": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with ASan/UBSan",
      "inherits": "headless",
      "cacheVariables": {
        "BULLY_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": { "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1" }
    }
  ]
}
