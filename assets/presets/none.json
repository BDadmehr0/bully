{
  "name": "none",
  "display_name": "No retro constraints",
  "description": "Modern pipeline defaults: full-resolution textures, mip chains, no triangle budget, per-pixel lighting.",
  "version": "1.0.0",
  "model": {
    "triangle_budget_per_character": 0,
    "triangle_budget_per_scene": 0,
    "max_bones_per_mesh": 256,
    "generate_lods": false,
    "lod_count": 1,
    "lod_triangle_ratios": [1.0],
    "bake_vertex_lighting": false,
    "weld_vertices": true
  },
  "texture": {
    "max_size": 0,
    "pixel_format": "rgba8",
    "generate_mips": true,
    "sampler": "linear",
    "wrap": "repeat",
    "atlas_max_size": 4096
  },
  "material": {
    "shader_preset": "standard.lit",
    "alpha_cutoff": 0.5,
    "allow_per_pixel_lighting": true
  },
  "audio": {
    "sample_rate": 48000,
    "channels": 2,
    "codec": "pcm16",
    "max_voices": 128
  },
  "render": {
    "resolution": [1920, 1080],
    "progressive": true,
    "colour_depth": 32,
    "dither": false,
    "fog": true
  }
}
